<div class="breadcrumb"><a href="/">← Dashboard</a></div>
<h1>{{.Name}}</h1>
{{if .HasBattery}}
  <p class="text-muted text-sm">
    <span class="battery{{if .BatteryLow}} battery-low{{end}}">
      🔋 {{.BatteryPercent}}%{{if .BatteryCharging}} ⚡{{end}}
    </span>
  </p>
{{end}}

<div class="card-static">
  <form method="get" style="display:flex;gap:0.5rem;align-items:end">
    <div>
      <label for="day">Day</label>
      <input id="day" name="day" type="date" value="{{.Day}}">
    </div>
    <button>View</button>
  </form>
</div>

<h2>Usage for {{.Day}}: {{dur .TotalMinutes}}</h2>
{{if .HasLimit}}
  <div class="bar-bg bar-xl" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{.BarPercent}}" aria-label="Daily usage {{.BarPercent}} percent of limit" style="width:100%;max-width:400px;margin-top:8px">
    {{if and .HasLimit (lt .WarnPct 100)}}<span class="bar-warn-tick" style="left:{{.WarnPct}}%" aria-hidden="true"></span>{{end}}
    <div class="bar-fill" style="background:{{.BarColor}};width:{{.BarPercent}}%"></div>
  </div>
  <div class="text-muted text-sm" style="margin-top:2px">{{dur .TotalMinutes}} / {{dur .LimitMin}} — {{.BarPercent}}%</div>
  {{if .BlockedBadge}}<span class="pill-badge pill-danger">BLOCKED</span>{{end}}
  {{if .WarnBadge}}<span class="pill-badge pill-warning">WARN</span>{{end}}
  <p class="muted">Limit: {{dur .LimitMin}} (warn at {{.WarnPct}}%)</p>
{{else}}<p class="muted">No total limit set</p>{{end}}

{{if .History}}
<h2>7-day history</h2>
<div style="margin-bottom:1rem">
<svg viewBox="0 0 280 100" role="img"
     aria-label="Daily usage over the last 7 days, maximum {{dur .HistoryMaxMinutes}}"
     style="width:100%;max-width:420px;height:120px">
  {{range .History}}
  <g>
    <title>{{.Day}}: {{dur .Minutes}}</title>
    <rect x="{{.X}}" y="{{.Y}}" width="{{.Width}}" height="{{.Height}}"
          rx="2" style="fill:var(--primary)"/>
  </g>
  {{end}}
  {{if .HasLimit}}<line x1="0" x2="280" y1="{{.LimitLineY}}" y2="{{.LimitLineY}}"
    style="stroke:var(--danger);stroke-width:1.5;stroke-dasharray:4 3"/>{{end}}
</svg>
</div>
{{end}}

<h2>Apps</h2>
<div class="table-wrapper">
<table class="table-styled"><thead><tr><th>App</th><th>Minutes</th><th>Status</th></tr></thead>
<tbody>
{{range .Apps}}
<tr>
  <td title="{{.Subject}}">{{.Label}}</td>
  <td>{{dur .Minutes}}</td>
  <td>{{if .Blocked}}<span class="pill-badge pill-danger">BLOCKED</span>{{else if .Warn}}<span class="pill-badge pill-warning">WARN</span>{{end}}</td>
</tr>
{{else}}
<tr><td colspan="3" class="text-muted" style="text-align:center">No apps tracked for {{.Day}}</td></tr>
{{end}}
</tbody>
</table>
</div>

<h2>Websites</h2>
<div class="table-wrapper">
<table class="table-styled"><thead><tr><th>Domain</th><th>Minutes</th><th>Status</th></tr></thead>
<tbody>
{{range .Websites}}
<tr>
  <td>{{.Label}}</td>
  <td>{{dur .Minutes}}</td>
  <td>{{if .Blocked}}<span class="pill-badge pill-danger">BLOCKED</span>{{else if .Warn}}<span class="pill-badge pill-warning">WARN</span>{{end}}</td>
</tr>
{{else}}
<tr><td colspan="3" class="text-muted" style="text-align:center">No websites tracked for {{.Day}}</td></tr>
{{end}}
</tbody>
</table>
</div>

<details>
<summary style="cursor:pointer;color:var(--primary);font-weight:500;font-size:1.15rem">⚙️ Device Settings</summary>
<div style="margin-top:0.75rem">
<form action="/devices/{{.ID}}/rename" method="post" hx-post="/devices/{{.ID}}/rename" hx-target="#toast" hx-swap="innerHTML" style="display:flex;gap:0.5rem;align-items:flex-end;margin-bottom:1rem">
  <div>
    <label for="rename">Rename device</label>
    <input id="rename" name="name" value="{{.Name}}" required>
  </div>
  <button class="btn">Rename</button>
</form>

<div style="margin-bottom:1rem">
<form action="/devices/{{.ID}}/recipients" method="post" hx-post="/devices/{{.ID}}/recipients" hx-target="#toast" hx-swap="innerHTML">
  <div>
    <label for="recipients">Report email recipients</label>
    <textarea id="recipients" name="emails" rows="3" placeholder="one email per line">{{range .Emails}}{{.}}
{{end}}</textarea>
    <p class="text-muted text-sm">Daily usage reports are emailed to these addresses a few hours after local midnight (default 3h).</p>
  </div>
  <button class="btn">Save recipients</button>
</form>
</div>

<div style="margin-bottom:1rem">
<form action="/devices/{{.ID}}/timezone" method="post" hx-post="/devices/{{.ID}}/timezone" hx-target="#toast" hx-swap="innerHTML" style="display:flex;gap:0.5rem;align-items:flex-end">
  <div>
    <label for="timezone">Device timezone</label>
    <input id="timezone" name="timezone" value="{{.TimeZone}}" placeholder="e.g. America/New_York">
    <p class="text-muted text-sm">Used to schedule the daily report a few hours after local midnight. Leave blank for UTC.</p>
  </div>
  <button class="btn">Save timezone</button>
</form>
</div>

<p><a href="/devices/{{.ID}}/limits" class="btn btn-primary">Manage limits</a></p>
<div style="margin-top:1rem">
<form action="/devices/{{.ID}}/delete" method="post" style="display:inline"
      onsubmit="return confirm('This will permanently delete this device and all its data. Continue?')">
  <button class="btn btn-danger">Delete device</button>
</form>
</div>
</div>
</details>
