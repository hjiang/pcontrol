<h1>Devices</h1>
<p class="text-muted text-sm">{{if .Devices}}{{len .Devices}} device{{if ne (len .Devices) 1}}s{{end}}{{else}}No devices yet{{end}}</p>
<p style="margin-bottom:1rem"><a href="/devices/new" class="btn btn-primary">+ Register device</a></p>
<div id="device-grid" hx-get="/" hx-trigger="every 30s" hx-swap="innerHTML">
  {{template "device_grid.gohtml" .}}
</div>
